// Dark theme palette — code-editor terminal aesthetic
// Inspired by VoltAgent, xAI, ElevenLabs DESIGN.md patterns
// Contrast tuned for WCAG AA readability on dark backgrounds
// Covers ALL component and page hardcoded colors

$dark-bg-base    = #141418
$dark-bg-surface = #1e1e24
$dark-bg-hover   = #2a2a32
$dark-border     = #333340
$dark-text-primary   = #e4e4ec
$dark-text-secondary = #a0a0ac
$dark-text-tertiary  = #787880
$dark-accent     = #00d992
$dark-accent-hover  = #00b87a
$dark-accent-dim = rgba(0, 217, 146, 0.12)
$dark-error      = #ff453a
$dark-warning    = #ff9f0a
$dark-success    = #30d158

$content-color = $dark-text-primary
$content-second-color = $dark-text-secondary
$accent-color = $dark-accent
$main-background-color = $dark-bg-base
$second-background-color = $dark-bg-surface
$hover-background-color = $dark-bg-hover
.theme--dark
  html
    color-scheme: dark

  body
    color: $content-color
    background-color: $main-background-color

  #panel
    background-color: $main-background-color

  // ====================================================
  // NAVIGATION
  // ====================================================
  .nav
    background-color: $main-background-color
    border-bottom: 1px solid $dark-border

  .nav .nav__item
    color: $dark-text-secondary

    &:hover
      background-color: transparent
      color: $dark-accent

    &:visited, &:active
      color: $dark-text-secondary

    &.nav--active
      color: $dark-accent !important

  .nav__item--round
    background-color: $dark-accent
    color: $dark-bg-base !important

  // ====================================================
  // SECTIONS / CARDS
  // ====================================================
  .section
    background-color: $dark-bg-surface
    box-shadow: none
    border: 1px solid $dark-border
    border-radius: 12px

  .section__title
    color: $dark-text-primary

  h1, h2, h3, h4, h5, h6
    color: $dark-text-primary

  // ====================================================
  // LINKS
  // ====================================================
  a, .link
    &, &:visited
      color: $dark-text-secondary
    &:hover, &:active
      color: $dark-accent

  .typo a:not(.user-profile-name):not(.media-link),
  .typo .link:not(.user-profile-name):not(.media-link),
  .typo-a:not(.user-profile-name):not(.media-link)
    &, &:visited, &:active, &:hover
      color: $dark-accent

  // ====================================================
  // BUTTONS
  // ====================================================
  .button:not(.codicon)
    background-color: $dark-bg-hover
    border: 1px solid $dark-border
    border-radius: 8px
    color: $dark-text-secondary
    transition: all 0.15s ease

    &:hover:not(.disabled)
      border-color: $dark-accent
      color: $dark-accent
      box-shadow: none

  .button.primary:not(.codicon)
    background-color: $dark-accent
    border-color: $dark-accent
    color: $dark-bg-base !important

    &:hover:not(.disabled)
      background-color: $dark-accent-hover
      border-color: $dark-accent-hover

  // ====================================================
  // DROPDOWNS / MENUS
  // ====================================================
  .dropdown .menu
    background-color: $dark-bg-hover
    border: 1px solid $dark-border
    border-radius: 8px
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5)

  .menu__link
    color: $dark-text-secondary

  a.menu__link:not(.disabled):hover,
  button.menu__link:not(.disabled):hover
    color: $dark-accent
    background-color: $dark-accent-dim

  a.menu__link.active,
  button.menu__link.active
    background-color: $dark-accent-dim
    color: $dark-accent

  .menu__seperator
    border-top-color: $dark-border

  .menu__link.highlight
    background: $dark-accent-dim

  // ====================================================
  // DIALOGS
  // ====================================================
  .dialog
    background-color: rgba($dark-bg-base, 0.75)

  .dialog.withBg .dialog__content
    background-color: $dark-bg-hover
    border: 1px solid $dark-border
    border-radius: 12px
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6)

  .dialog--signin__main
    background-color: $dark-bg-hover
    border: 1px solid $dark-border
    border-radius: 12px
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6)

  // ====================================================
  // FORM INPUTS (textbox)
  // ====================================================
  input.textbox, textarea.textbox
    background-color: $dark-bg-hover
    color: $dark-text-primary
    border-color: $dark-border

    &:focus
      border-color: $dark-accent
      outline-color: $dark-accent-dim

    &::placeholder
      color: $dark-text-tertiary

  label
    color: $dark-text-secondary

  // ====================================================
  // TABLES
  // ====================================================
  .data-table tr
    border-top: 1px solid $dark-border
    border-bottom: 1px solid $dark-border

  .data-table tr:nth-child(even)
    background-color: rgba(255, 255, 255, 0.02)

  .data-table thead>tr
    border-bottom-color: $dark-border

  .section__table-header
    background-color: rgba($dark-bg-base, 0.95)
    box-shadow: none

  .typo table th, .typo table td, .typo table caption
    border-color: $dark-border
    color: $dark-text-secondary

  .typo table thead th
    background: $dark-bg-hover
    color: $dark-text-primary

  .typo table th
    background: $dark-bg-hover

  // ====================================================
  // FORMS
  // ====================================================
  input, textarea
    background-color: $dark-bg-hover
    border: 1px solid $dark-border
    border-radius: 8px
    color: $dark-text-primary

    &:focus
      border-color: $dark-accent
      outline: 2px solid rgba($dark-accent, 0.15)

  .search>input
    border-color: $dark-border
    color: $dark-text-primary
    background-color: $dark-bg-hover

  .select
    border: 1px solid $dark-border
    border-radius: 8px
    background-color: $dark-bg-hover
    color: $dark-text-primary

  .select:focus
    border-color: $dark-accent
    outline-color: rgba($dark-accent, 0.2)

  .checkbox input
    border-color: $dark-border

  label.textbox.material input
    border-color: $dark-border
    color: $dark-text-secondary

  label:not(.quick-input-list-label)
    color: $dark-text-secondary

  .help-text
    color: $dark-text-tertiary

  // ====================================================
  // CODE
  // ====================================================
  pre
    background-color: $dark-bg-hover
    border-radius: 8px
    color: $dark-text-primary
    text-shadow: none

  code
    background-color: $dark-bg-hover
    border-radius: 4px
    color: $dark-text-primary
    text-shadow: none

  pre code
    background-color: transparent

  // ====================================================
  // BLOCKQUOTES
  // ====================================================
  blockquote
    background-color: $dark-bg-surface
    color: $dark-text-secondary
    border-left-color: $dark-border

    &.blue, &.red, &.yellow, &.warn, &.note
      background-color: $dark-bg-surface
      color: $dark-text-secondary

  blockquote.note
    border-left-color: $dark-accent
    &:before
      color: $dark-accent

  blockquote.warn
    border-left-color: $dark-error
    &:before
      color: $dark-error

  blockquote.red
    border-left-color: $dark-error

  blockquote.yellow
    border-left-color: $dark-warning

  blockquote.blue
    border-left-color: $dark-accent

  // ====================================================
  // TAB COMPONENT
  // ====================================================
  .section__tab-header-item
    color: $dark-text-secondary !important

    &:hover
      background: $dark-bg-hover
      border-color: $dark-accent

    &.tab--active
      border-color: $dark-accent
      color: $dark-text-primary !important

  .section__tab-item
    border-bottom-color: $dark-border

  .section__tab-title
    color: $dark-text-tertiary

  .section__tab-container.immersive .section__tab-header-item.selected
    background-color: $dark-bg-surface
    color: $dark-text-primary
    box-shadow: none

  // ====================================================
  // PROBLEM TAGS
  // ====================================================
  .problem__tag-link
    background-color: $dark-bg-hover
    color: $dark-text-secondary !important
    border-radius: 4px

  .problem__tag-item
    color: $dark-text-secondary

  // ====================================================
  // MESSAGEPAD (私信)
  // ====================================================
  .messagepad__sidebar
    border-right-color: $dark-border

  .messagepad__list-item:hover
    border-color: $dark-border
    background-color: $dark-bg-hover

  .messagepad__list-item.active
    border-color: $dark-accent
    background-color: $dark-accent-dim

  .messagepad__input
    border-top-color: $dark-border

  .side--self .messagepad__message__body
    background: $dark-bg-hover
    color: $dark-text-primary

    &:after
      border-top-color: $dark-bg-hover

  .side--other .messagepad__message__body
    background: $dark-accent
    color: $dark-bg-base

    &:after
      border-top-color: $dark-accent


  // ====================================================
  // TOOLTIP
  // ====================================================
  .tooltip
    .drop-content
      background: $dark-bg-hover
      color: $dark-text-primary
      box-shadow: 1px 1px 4px rgba(0, 0, 0, 0.5)

    &.drop-element-attached-bottom .drop-content:before
      border-top-color: $dark-bg-hover

    &.drop-element-attached-top .drop-content:before
      border-bottom-color: $dark-bg-hover

  // ====================================================
  // MARKER (context menu)
  // ====================================================
  body>.marker
    background-color: $dark-bg-hover
    border-color: $dark-border
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5)
    border-radius: 8px

  body>.marker .marker__toolbar
    background-color: $dark-bg-hover

  // ====================================================
  // HINT / NOTIFICATION BANNER
  // ====================================================
  .hint
    background: $dark-bg-hover
    color: $dark-warning
    border-bottom: 1px solid $dark-border

  // ====================================================
  // GLOBAL NOTIFICATION
  // ====================================================
  .global-notification
    background: $dark-bg-hover
    color: $dark-text-primary
    border-bottom: 1px solid $dark-border

    &.warning
      background: rgba($dark-warning, 0.12)
      color: $dark-warning
      border-bottom-color: rgba($dark-warning, 0.3)

  // ====================================================
  // STATUS COLORS
  // ====================================================
  .col--status, .col--submit-by, .col--lang, .col--case
    border-right-color: $dark-border

  .col--ac-tried
    border-left-color: $dark-border

  .col--role
    border-left-color: $dark-border

  // ====================================================
  // FOOTER
  // ====================================================
  .footer
    background-color: $dark-bg-surface
    color: $dark-text-secondary
    border-top: 1px solid $dark-border

  @media only screen and (max-width: 600px)
    .footer__category
      border-bottom-color: $dark-border

  // ====================================================
  // PAGER
  // ====================================================
  .pager.pager-top
    border-bottom-color: $dark-border
    .pager__item
      border-bottom-color: $dark-border

  .pager.pager-bottom
    border-top-color: $dark-border
    .pager__item
      border-top-color: $dark-border

  .pager__item
    color: $dark-text-tertiary

    &.link
      &, .typo &
        color: $dark-text-tertiary

      &:hover
        border-color: $dark-accent
        &, .typo &
          color: $dark-text-secondary

    &.current
      color: $dark-accent !important
      border-color: $dark-accent !important

  // ====================================================
  // SIDEBAR
  // ====================================================
  .sidebar-user-profile .user-profile-name
    color: $dark-text-primary

  // ====================================================
  // MISC STATUS
  // ====================================================
  .sessionlist__item
    border-bottom-color: $dark-border

  .section__list__item
    border-bottom-color: $dark-border

  .section__footer
    border-top-color: $dark-border

  .nothing-icon
    filter: brightness(75%)

  .typo img
    opacity: 0.92

  hr
    border-bottom-color: $dark-border

  // ====================================================
  // SUPPLEMENTARY TEXT
  // ====================================================
  .supplementary
    color: $dark-text-secondary

    a, a:visited, a:hover
      color: $dark-text-secondary

  .numbox__text
    color: $dark-text-tertiary

  // ====================================================
  // MARK / HIGHLIGHT
  // ====================================================
  mark
    background: rgba($dark-warning, 0.2)
    color: $dark-text-primary

  // ====================================================
  // AUTOCOMPLETE
  // ====================================================
  .autocomplete-list
    background-color: $dark-bg-hover
    border: 1px solid $dark-border
    border-radius: 8px

    li[aria-selected=true]
      background-color: $dark-bg-surface

    li[data-focus=true]
      background-color: $dark-accent-dim
      cursor: pointer

  .autocomplete-tag
    background-color: $dark-accent
    color: $dark-bg-base

  // ====================================================
  // COMMENTS / DISCUSSION
  // ====================================================
  .dczcomments__item, .dczcomments__reply
    border-top-color: $dark-border

  .dczcomments__operations
    color: $dark-text-tertiary

    a, a:visited
      color: $dark-text-tertiary

    a:hover
      color: $dark-accent

  .dczcomments__item .vote-button
    color: $dark-text-tertiary

    &.downvote.active
      color: #ff453a
    &.upvote.active
      color: #30d158

  // ====================================================
  // REACTION POPOVER
  // ====================================================
  .popover-reaction-item:hover
    background: $dark-accent-dim
    color: $dark-accent

  .popover-reaction-item
    color: $dark-text-secondary

  // ====================================================
  // CATEGORY FILTER
  // ====================================================
  .widget--category-filter__drop
    background-color: $dark-bg-hover
    border: 1px solid $dark-border
    border-radius: 8px
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5)

  .category-filter__header .list .list__item
    background: $dark-bg-hover

  .category-filter__body
    background: $dark-bg-surface

    .search-tag__item
      background: $dark-bg-hover

  .search-tag__item:hover
    background: $dark-bg-surface
    color: $dark-text-primary

  // ====================================================
  // OMNIBAR
  // ====================================================
  .omnibar-toggle
    background-color: $main-background-color
    color: $dark-text-secondary

  .omnibar-main
    color: $content-color

    input
      background-color: $dark-bg-hover !important
      border-color: $dark-border !important
      color: $dark-text-primary !important

    .omnibar-content-section
      background-color: $dark-bg-hover !important
      border-color: $dark-border !important

  // ====================================================
  // RECORD / STATUS PAGES
  // ====================================================
  .col--status__progress
    background: rgba($dark-warning, 0.15)

  &.hasjs .collapsed #status:not([data-status="7"]) .compiler-text-mask
    background-image: linear-gradient(to bottom, transparent, $dark-bg-base 25px)

  &.page--record_detail .subtask
    background-color: $dark-bg-base !important

  // ====================================================
  // CONTEST SCOREBOARD
  // ====================================================
  &.page--contest_scoreboard .star-highlight
    background: $dark-bg-hover

  // ====================================================
  // CONTEST PAGE
  // ====================================================
  .section--contest .detail-button
    background: $dark-accent
    color: $dark-bg-base

  // ====================================================
  // ERROR PAGE
  // ====================================================
  &.page--error
    color: $dark-text-primary

  // ====================================================
  // SYNTAX HIGHLIGHTING (VS Code Dark+ inspired)
  // ====================================================
  .token
    text-shadow: none

  .token.comment, .token.prolog, .token.doctype, .token.cdata
    color: #6a9955
    font-style: italic

  .token.namespace
    opacity: 0.7

  .token.string
    color: #ce9178

  .token.punctuation, .token.operator
    color: #b0b0b0

  .token.url, .token.symbol, .token.number, .token.boolean, .token.variable, .token.constant, .token.inserted
    color: #b5cea8

  .token.atrule, .token.keyword, .token.attr-value
    color: #569cd6

  .token.function
    color: #dcdcaa

  .token.class-name
    color: #4ec9b0

  .token.tag, .token.selector
    color: #569cd6

  .token.attr-name, .token.property, .token.regex, .token.entity
    color: #9cdcfe

  .token.important, .token.bold
    font-weight: 700

  .token.italic
    font-style: italic

  // ====================================================
  // SCROLLBAR
  // ====================================================
  ::-webkit-scrollbar-track
    background: $dark-bg-base

  ::-webkit-scrollbar-thumb
    background: $dark-border
    border-radius: 8px

    &:hover
      background: $dark-text-tertiary

  // ====================================================
  // SCRATCHPAD (??????)
  // ====================================================
  .scratchpad-container
    background: $dark-bg-base

  .scratchpad__toolbar
    background: $dark-bg-surface

  .scratchpad__toolbar__button
    color: $dark-text-secondary

    &.enabled:hover
      color: $dark-accent
      background: $dark-accent-dim

    &.activated
      color: $dark-bg-base !important
      background: $dark-accent !important

  .scratchpad__toolbar__split
    background: $dark-border

  .scratchpad__tablist
    div
      fill: $dark-text-tertiary
      color: $dark-text-tertiary

      &:hover
        fill: $dark-text-primary
        color: $dark-text-primary

    div.scratchpad__tab-active
      border-left-color: $dark-accent
      fill: $dark-accent
      color: $dark-accent

  .scratchpad__data-input
    background: $dark-bg-hover
    border-left-color: $dark-border
    color: $dark-text-secondary

    &:focus
      background: $dark-bg-surface
      border-left-color: $dark-accent

  .icol--stat
    color: $dark-text-tertiary

  // Problem detail tab headers
  .section__tab-header-item
    &:hover
      background: $dark-accent-dim
